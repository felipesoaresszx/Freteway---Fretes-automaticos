# Copie para backend/.env.production no servidor e proteja com chmod 600.
ENVIRONMENT=production
# Exponha Swagger/ReDoc somente quando for necessario. O proxy tambem deve
# encaminhar essas rotas ao backend (configuracao padrao deste projeto).
API_DOCS_ENABLED=true
ALLOW_INSECURE_HTTP=false
PUBLIC_BASE_URL=https://app.freteway.com.br
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
CREDENTIAL_ENCRYPTION_KEY=use-outro-segredo-aleatorio-com-32-ou-mais-caracteres
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# Omita COOKIE_DOMAIN para cookies host-only (recomendado).
CORS_ORIGINS=["https://app.freteway.com.br"]
TRUSTED_HOSTS=["app.freteway.com.br","backend","localhost","127.0.0.1"]
ACCESS_TOKEN_EXPIRE_MINUTES=60
TABELA_FRETE_STORAGE_DIR=/app/storage/tabelas_frete
EMPRESA_LOGO_STORAGE_DIR=/app/storage/configuracoes/logos
DOCUMENT_STORAGE_DIR=/app/storage/documentos
TIMEOUT_API_INTEGRACAO=15
TIMEOUT_BROWSER_INTEGRACAO=60
WORKER_MAX_CONCURRENCY=4
WORKER_JOB_TIMEOUT_SECONDS=300
WORKER_STALE_AFTER_SECONDS=300
# Use "openai" para habilitar o agente. O worker recebe estas variÃ¡veis pelo env_file.
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=gpt-5-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=120
AI_MAX_DOCUMENT_CHARS=120000
AI_MIN_CONFIDENCE=0.90
CACHE_CEP_TTL_SECONDS=86400
SANKHYA_API_KEY=gere-uma-chave-aleatoria-exclusiva-com-32-ou-mais-caracteres
INTEGRATION_RETRY_ATTEMPTS=3
INTEGRATION_MAX_CONCURRENCY=10
INTEGRATION_CIRCUIT_FAILURES=5
INTEGRATION_CIRCUIT_RESET_SECONDS=60
