# Copie para .env.production no servidor e proteja com chmod 600.
DOMAIN=app.freteway.com.br
SITE_ADDRESS=https://app.freteway.com.br
TLS_EMAIL=ops@example.com
POSTGRES_DB=frete
POSTGRES_USER=frete
POSTGRES_PASSWORD=change-me-with-a-long-random-password
# Mesma senha acima, com caracteres reservados em percent-encoding para a URL SQLAlchemy.
POSTGRES_PASSWORD_URLENCODED=change-me-with-a-long-random-password
APP_STORAGE_VOLUME_NAME=freteway_app_storage
# Mantenha false enquanto o Nginx do host ocupar as portas 80/443.
ACTIVATE_PROXY=false
